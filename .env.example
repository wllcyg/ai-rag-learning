# Cloudflare Tunnel Token
CLOUDFLARED_TUNNEL_TOKEN=your_cloudflared_tunnel_token_here

# PostgreSQL Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=knowledge_hub

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=mongo_user
MONGO_INITDB_ROOT_PASSWORD=your_mongo_password
MONGO_INITDB_DATABASE=knowledge_hub

# Mongo Express Configuration
ME_CONFIG_BASICAUTH_USERNAME=me_admin
ME_CONFIG_BASICAUTH_PASSWORD=your_mongo_express_password

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password

# RabbitMQ Configuration
RABBITMQ_URI=amqp://guest:guest@localhost:5672

# Cloudflare R2 Storage Configuration (S3 Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=my-images
R2_PUBLIC_DOMAIN=https://image-dev.yourdomain.com

# RAG Embedding & Chunking Configuration
DASHSCOPE_API_KEY=your_dashscope_api_key_here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10

RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

